<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.vpnguard.helper</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Library/PrivilegedHelperTools/local.vpnguard.helper</string>
		<string>run</string>
	</array>
	<key>MachServices</key>
	<dict>
		<key>local.vpnguard.helper.xpc</key>
		<true/>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardOutPath</key>
	<string>/var/log/vpnguard.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/vpnguard.log</string>
</dict>
</plist>
